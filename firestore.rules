rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ tài khoản chung của team được đọc và ghi.
    // Đổi email bên dưới nếu bạn dùng email khác cho tài khoản team.
    match /island/{doc} {
      allow read, write: if request.auth != null
                          && request.auth.token.email == "team@dao.local";
    }
  }
}
